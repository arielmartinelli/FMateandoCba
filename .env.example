# Configuración del Negocio
VITE_WHATSAPP_NUMBER=5493518013657

# ⚠ ATENCIÓN: todas las variables VITE_* se compilan DENTRO del JavaScript
# público del sitio. Cualquiera puede leerlas desde el navegador.
# Esta contraseña NO protege la base de datos, sólo esconde el panel a simple
# vista. El plan para reemplazarla por Supabase Auth está en docs/INFORME.md.
VITE_ADMIN_PASSWORD=cambiala_por_una_propia

# Conexión a Supabase.
# Si faltan, el sitio funciona guardando SÓLO en el navegador de cada visitante
# (los cambios no se comparten entre dispositivos). El panel de administración
# lo avisa de forma explícita.
# En Vercel: Settings → Environment Variables → los 3 entornos → redeploy.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-publicable
